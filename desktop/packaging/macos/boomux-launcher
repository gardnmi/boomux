#!/bin/sh
set -eu
# The Rust bootstrap uses bounded subprocesses before GPUI starts. It always
# opens the GUI after shell/daemon failures so Finder users can recover.
bundle=$(CDPATH= cd -- "$(/usr/bin/dirname -- "$0")/.." && pwd -P)
if [ ! -x "$bundle/MacOS/boomux-desktop" ]; then
    echo 'Boomux Desktop is missing from the app. Reinstall the complete app.' >&2
    /usr/bin/osascript -e 'display alert "Boomux could not open" message "Boomux Desktop is missing from the app. Reinstall the complete app and try again." as critical' || :
    exit 1
fi
exec "$bundle/MacOS/boomux-desktop" --macos-launch "$@"
