---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const clips = [
  { id: 'move', label: 'Move', title: 'Drag it. Snap it. Make it yours.', description: 'Drag to move. Tap Ctrl + Space, then Shift + Arrow keys to swap panes. F expands a pane to fill the canvas; press it again in layout mode to return.' },
  { id: 'resize', label: 'Resize', title: 'Make room for what matters.', description: 'Drag a pane edge to give your editor more space, or keep your server and tests in view.' },
  { id: 'keyboard', label: 'Keyboard', title: 'Stay on the keys.', description: 'Tap Ctrl + Space for layout mode. Arrow keys change focus; J flips the split between side-by-side and stacked. Escape returns to the terminal.' },
  { id: 'tabs', label: 'Tabs', title: 'Clear the canvas. Keep the work.', description: 'Ctrl + W minimizes a pane into a tab without stopping its shell. Click a tab to bring it back, right where you left off.' },
];
---
<section id="in-motion" class="motion-showcase" aria-label="Boomux Desktop in motion">
  <div class="motion-bar">
    <span>BOOMUX / IN MOTION</span>
    <div class="motion-tabs" role="tablist" aria-label="Desktop demonstrations" hidden>
      {clips.map((clip, index) => <button type="button" id={`motion-tab-${clip.id}`} role="tab" aria-controls={`motion-${clip.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-motion-tab={clip.id}><span aria-hidden="true">0{index + 1}</span> {clip.label}</button>)}
    </div>
  </div>
  {clips.map(clip => <figure id={`motion-${clip.id}`} class="motion-panel" data-motion-panel={clip.id}>
    <video width="1280" height="800" controls muted loop playsinline preload="none" poster={`${base}/demos/poster.webp`} aria-label={`${clip.label}: real Boomux Desktop demonstration`} aria-describedby={`motion-description-${clip.id}`}>
      <source src={`${base}/demos/${clip.id}.mp4`} type="video/mp4" />
      <a href={`${base}/demos/${clip.id}.mp4`}>Download the {clip.label.toLowerCase()} demonstration</a>
    </video>
    <figcaption>
      <div><h2>{clip.title}</h2><p id={`motion-description-${clip.id}`}>{clip.description}</p></div>
      <a class="text-link" href={`${base}/demos/${clip.id}.gif`} download>Download GIF <span aria-hidden="true">↓</span></a>
    </figcaption>
  </figure>)}
  <p class="motion-note">Real Desktop recordings · Tree and Tabs views · Fictional demo terminal content · No audio</p>
</section>
